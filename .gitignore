# Dependencies (reinstall with `npm install`)
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment variables / secrets — never commit these to a public repo
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

